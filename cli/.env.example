DTH_RELEASES_FOLDER=D:/Dropbox/3D/_resources/_DazToHue
UNINSTALL_MY_DAZ_LIB_FOLDER=D:/DAZ 3D
DAZ_LIB_FOLDER=D:/DAZ 3D/My DAZ 3D Library
DAZ_SCRIPTS_FOLDER=D:/DAZ 3D/My DAZ 3D Library/Scripts
DAZ_ASSETS_G3=D:/Dropbox/3D/daz3d/_genesis 3
DAZ_ASSETS_G8=D:/Dropbox/3D/daz3d/_genesis 8
DAZ_ASSETS_G9=D:/Dropbox/3D/daz3d/_genesis 9

# Optional - defaults to C:/Program Files/DAZ 3D/DAZStudio4/plugins
DAZ_PLUGINS_FOLDER=C:/Program Files/DAZ 3D/DAZStudio4/plugins

# Presets sync (for install-presets command)
DAZ_PRESETS_SOURCE=D:/Dropbox/3D/daz3d/_presets
DAZ_PRESETS_DEST=E:/User Data/Documents/DAZ 3D/Studio/My Library/Presets

# Houdini DTH install (for install-houdini-dth command)
HOUDINI_FOLDER=D:/User Data/Documents/houdini20.5

# Houdini presets sync (for install-houdini-presets command)
HOUDINI_PRESETS_SOURCE=D:/Dropbox/3D/houdini/my_presets

# Soltude DazToHue-Scripts repo (for sync-sol-scripts command)
SOL_SCRIPTS_FOLDER=D:/Development/DazToHue-Scripts
