{
  "name": "dth-scripts-cli",
  "version": "1.0.0",
  "description": "CLI for syncing DTH Scripts to DAZ Studio",
  "type": "module",
  "scripts": {
    "sync-daz-dth-scripts": "tsx src/index.ts",
    "sync-daz-dth-scripts:dry": "tsx src/index.ts --dry-run",
    "list-daz-assets": "tsx src/index.ts list-daz-assets",
    "list-daz-assets:g3": "tsx src/index.ts list-daz-assets --gen 3",
    "list-daz-assets:g8": "tsx src/index.ts list-daz-assets --gen 8",
    "list-daz-assets:g9": "tsx src/index.ts list-daz-assets --gen 9",
    "uninstall-daz": "tsx src/index.ts uninstall-daz",
    "uninstall-daz:dry": "tsx src/index.ts uninstall-daz --dry-run",
    "install-daz-assets": "tsx src/index.ts install-daz-assets",
    "install-daz-assets:dry": "tsx src/index.ts install-daz-assets --dry-run",
    "install-daz-assets:g9": "tsx src/index.ts install-daz-assets --gen 9",
    "install-daz-dth": "tsx src/index.ts install-daz-dth",
    "install-daz-dth:dry": "tsx src/index.ts install-daz-dth --dry-run",
    "install-daz-presets": "tsx src/index.ts install-daz-presets",
    "install-daz-presets:dry": "tsx src/index.ts install-daz-presets --dry-run",
    "install-houdini-dth": "tsx src/index.ts install-houdini-dth",
    "install-houdini-dth:dry": "tsx src/index.ts install-houdini-dth --dry-run",
    "install-houdini-presets": "tsx src/index.ts install-houdini-presets",
    "install-houdini-presets:dry": "tsx src/index.ts install-houdini-presets --dry-run",
    "sync-sol-scripts": "tsx src/index.ts sync-sol-scripts",
    "sync-sol-scripts:dry": "tsx src/index.ts sync-sol-scripts --dry-run"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "args": "^5.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/args": "^5.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
